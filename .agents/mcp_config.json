{
  "mcpServers": {
    "puppeteer": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "supabase-postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:5432/postgres"
      ]
    },
    "netlify": {
      "command": "npx",
      "args": [
        "-y",
        "@smithery/cli@latest",
        "run",
        "@modelcontextprotocol/server-netlify",
        "--config",
        "{\"netlifyToken\":\"YOUR_NETLIFY_API_TOKEN\"}"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp"
      ],
      "env": {
        "SUPABASE_URL": "https://mxtwkwhidqxpcjmjferw.supabase.co",
        "SUPABASE_ACCESS_TOKEN": "sb_publishable_jiIeaDGrWoflSKFwc48LzQ_BrUetrrM"
      }
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn-ui-mcp-server"
      ]
    }
  }
}
